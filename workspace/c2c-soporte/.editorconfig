# .editorconfig — formato de código uniforme para CUALQUIER IDE.
# Generado desde el orquestador (C:\RODCONFIGALLPROJECTS). Igual para todos los proyectos.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
